# UTE Tea / local on Windows. Copy to .env, then fill in YOUR credentials.
# This file contains no usable passwords. .env is ignored by git.
#
# Neon JDBC: Copy host from Neon > Connect (choose direct connection).
# Keep the jdbc: prefix for Spring Boot; don't paste a postgresql:// URL.
DB_URL=jdbc:postgresql://YOUR_NEON_ENDPOINT/utetea?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=CHANGE_ME
# For SQL Server instead, change to:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTE_Tea;encrypt=true;trustServerCertificate=true
# DB_USERNAME=sa
# DB_PASSWORD=CHANGE_ME
#
# SQL schema remains unchanged on Neon (validate), SQL Server is not auto-migrated.
JPA_DDL_AUTO=validate
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
JWT_COOKIE_SECURE=false
WS_ALLOWED_ORIGIN=http://localhost:8080
DEMO_SEED_ENABLED=false
ADMIN_BOOTSTRAP_ENABLED=false
SHIPPER_BOOTSTRAP_ENABLED=false
# Generated only in the local PowerShell process when using the launcher:
JWT_SECRET_BASE64=GENERATE_ON_START
OTP_SECRET=GENERATE_ON_START

# Optional: leave blank unless the feature is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/marketplace
