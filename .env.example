# ========================================================
# UTE Tea - Môi trường mẫu (.env.example)
# Hướng dẫn: Sao chép thành .env (cp .env.example .env) và điền thông tin thực tế.
# LƯU Ý: Tuyệt đối không commit file .env chứa mật khẩu thật lên Git repository.
# ========================================================

# 1. Cấu hình hồ sơ chạy (Profile)
# - local : Môi trường phát triển nội bộ
# - prod  : Môi trường triển khai chính thức (bật cache, log rolling, tắt demo seed)
SPRING_PROFILES_ACTIVE=local

# 2. Cấu hình Cổng & Tên miền (URL Public)
# SERVER_PORT dùng cho Spring Boot (mặc định 8080)
SERVER_PORT=8080

# APP_BASE_URL: Địa chỉ tên miền công khai của website để tạo link mã QR chính xác
# Ví dụ: https://milktea.yourdomain.com hoặc http://your_server_ip
APP_BASE_URL=http://localhost:8080

# Cho phép Nginx / Cloud reverse proxy forward header HTTPS (Host, Proto, Port)
SERVER_FORWARD_HEADERS_STRATEGY=framework

# 3. Cấu hình Cơ sở dữ liệu Microsoft SQL Server
# - Khi chạy Docker Compose: db:1433
# - Khi chạy kết nối remote hoặc local: localhost:1433
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTE_Tea;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
# Mật khẩu SA phải thỏa mãn độ phức tạp SQL Server: tối thiểu 8 ký tự, chữ hoa, chữ thường, số, ký tự đặc biệt
DB_PASSWORD=ChangeThisSecurePassword2026!

# ddl-auto: 'validate' trên production (khuyến nghị), hoặc 'update' trong giai đoạn dựng ban đầu
JPA_DDL_AUTO=none

# 4. Cấu hình Bảo mật JWT & Cookie
# Sinh khóa ngẫu nhiên Base64 tối thiểu 256 bits (32 bytes), ví dụ bằng lệnh Linux: openssl rand -base64 32
JWT_SECRET_BASE64=dGhpc0lzQVZlcnlTZWN1cmVCYXNlNjRTZWNyZXRLZXlGb3JNaWxrVGVhQXBwMjAyNg==

# Bật 'true' khi chạy HTTPS (sản xuất) để bật cờ 'Secure' cho cookie HttpOnly milktea_access_token
JWT_COOKIE_SECURE=true

# 5. Cấu hình Realtime WebSocket STOMP
# Khớp với URL domain của trang web để phòng chống tấn công Cross-Site WebSocket Hijacking
WS_ALLOWED_ORIGIN=http://localhost:8080

# 6. Cấu hình Dịch vụ Lưu trữ Hình ảnh Cloudinary
# Đăng ký tài khoản miễn phí tại https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 7. Cấu hình Gửi Email (SMTP Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Google App Password, khong dung mat khau dang nhap Gmail
MAIL_FROM=
MAIL_SENDER_NAME=UTE Tea
OTP_SECRET=
# Co so phuc vu menu/ban POS cu chua co ShopId; dien ID Shop thuc te
POS_SHOP_ID=0

# 8. Mật khẩu khởi tạo Quản trị viên (Admin Seed)
ADMIN_PASSWORD=your_admin_password


# BIN ngan hang 6 chu so; so TK/chu TK cau hinh trong Quan tri > Cai dat
VIETQR_BANK_BIN=

# Optional demo-only datasource override; default persists in ./data/ute-tea-demo
# DEMO_DB_URL=jdbc:h2:file:./data/ute-tea-demo;DB_CLOSE_ON_EXIT=FALSE;MODE=MSSQLServer
